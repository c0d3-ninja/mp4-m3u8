{
  "manifest_version": 3,
  "name": "TikTok Drama → JSON",
  "version": "1.1.0",
  "description": "Adds TikTok short dramas to ~/Desktop/dramas-next.json.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "downloads"],
  "host_permissions": [
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://*.tiktokcdn-eu.com/*",
    "https://*.ibyteimg.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*", "https://chatgpt.com/*", "https://dramasave.app/*", "http://localhost:5173/*"],
      "js": ["prompt-card.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
