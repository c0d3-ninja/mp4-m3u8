PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ffmpeg / ffprobe binaries (defaults to whatever is on your PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# x264 preset: ultrafast | superfast | veryfast | faster | fast | medium | slow
FFMPEG_PRESET=veryfast
# HLS segment length in seconds
HLS_SEGMENT_SECONDS=4
# Episodes converted at the same time, across all conversions (1: one ffmpeg already uses every core)
CONCURRENCY=1

# Folder listed in the "Folders" tab, where folders/files can be deleted (default: ~/Downloads)
# DOWNLOADS_DIR=/home/ubuntu/Downloads
