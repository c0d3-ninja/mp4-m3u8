PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ffmpeg / ffprobe binaries (defaults to whatever is on your PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# x264 preset: ultrafast | superfast | veryfast | faster | fast | medium | slow
FFMPEG_PRESET=veryfast
# HLS segment length in seconds
HLS_SEGMENT_SECONDS=4
# Episodes converted at the same time, across all conversions (1: one ffmpeg already uses every core)
CONCURRENCY=1
# Share of the CPU ffmpeg may use, in percent (thread count on macOS; also pinned to cores with taskset on Linux)
FFMPEG_CPU_PERCENT=80
# NVIDIA GPU encoding (Linux): preset p1 (fastest) … p7 (best quality), and encode sessions at once
# (one per quality per episode; GeForce cards allow 8)
# NVENC_PRESET=p5
# NVENC_SESSIONS=8

# Folder listed in the "Folders" tab, where folders/files can be deleted (default: ~/Downloads)
# DOWNLOADS_DIR=/home/ubuntu/Downloads
